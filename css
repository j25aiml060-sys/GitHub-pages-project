
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f6f9;
    color: #333;
    line-height: 1.6;
}

header {
    background-color: #172554;
    color: white;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 18px;
}

nav a:hover {
    color: #fbbf24;
}

.hero {
    background: linear-gradient(120deg, #172554, #2563eb);
    color: white;
    text-align: center;
    padding: 100px 20px;
}

.hero h1 {
    font-size: 42px;
    margin-bottom: 10px;
}

.btn {
    display: inline-block;
    background-color: #fbbf24;
    color: #172554;
    padding: 12px 24px;
    margin-top: 25px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
}

section:not(.hero) {
    padding: 55px 10%;
    text-align: center;
}

section h2 {
    color: #172554;
    margin-bottom: 20px;
}

#about p {
    max-width: 700px;
    margin: auto;
}

.project {
    background-color: white;
    padding: 22px;
    margin: 15px auto;
    max-width: 650px;
    border-radius: 8px;
    box-shadow: 0 2px 8px #00000015;
}

.project h3 {
    color: #2563eb;
    margin-bottom: 8px;
}

form {
    max-width: 500px;
    margin: auto;
}

input, textarea {
    width: 100%;
    padding: 12px;
    margin: 10px 0;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-family: Arial, sans-serif;
}

button {
    background-color: #172554;
    color: white;
    padding: 12px 25px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background-color: #2563eb;
}

.note {
    margin-top: 15px;
    font-size: 13px;
    color: #666;
}

footer {
    background-color: #172554;
    color: white;
    text-align: center;
    padding: 18px;
}

@media (max-width: 600px) {
    header {
        flex-direction: column;
    }

    nav a {
        margin: 0 6px;
    }

    .hero h1 {
        font-size: 30px;
    }
}
